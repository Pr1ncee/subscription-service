# Configuration for the docker compose stack. All settings are read from the
# environment at startup and validated by subscriptions_service.config.Settings.
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/subscriptions
RABBITMQ_URL=amqp://app:app@rabbitmq:5672/
REMINDER_OFFSETS_DAYS=3,1,0
RELAY_POLL_INTERVAL_S=0.5
RELAY_BATCH_SIZE=100
SCHEDULER_POLL_INTERVAL_S=1.0
SCHEDULER_BATCH_SIZE=100
RELAY_MAX_BACKOFF_S=60
CONSUMER_DELIVERY_LIMIT=5
PUBLISH_TIMEOUT_S=5.0
LOG_LEVEL=INFO
